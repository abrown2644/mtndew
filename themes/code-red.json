		"list.inactiveSelectionForeground": "#d1707c",
		"list.hoverBackground": "#170709",
		"list.hoverForeground": "#ffb454",
		"list.focusBackground": "#3d131a",
		"list.focusForeground": "#ffdde1",
		"list.highlightForeground": "#ffb454",
		"list.dropBackground": "#4a151d",
		"list.errorForeground": "#ff1744",
		"list.warningForeground": "#ffd166",
		"tree.indentGuidesStroke": "#3d131a",

		// Title Bar / Menus
		"titleBar.activeBackground": "#0a0407",
		"titleBar.activeForeground": "#d1707c",
		"titleBar.inactiveBackground": "#0a0407",
		"titleBar.inactiveForeground": "#5a2028",
		"titleBar.border": "#0a0407",
		"menu.background": "#120609",
		"menu.foreground": "#d1707c",
		"menu.selectionBackground": "#3d131a",
		"menu.selectionForeground": "#ffdde1",
		"menu.border": "#2a0d12",
		"menubar.selectionBackground": "#3d131a",
		"menubar.selectionForeground": "#ffdde1",

		// Status Bar
		"statusBar.background": "#120609",
		"statusBar.foreground": "#d1707c",
		"statusBar.border": "#0a0407",
		"statusBar.noFolderBackground": "#120609",
		"statusBar.noFolderForeground": "#d1707c",
		"statusBar.debuggingBackground": "#6b1030",
		"statusBar.debuggingForeground": "#ffdde1",
		"statusBarItem.hoverBackground": "#3d131a",
		"statusBarItem.prominentBackground": "#170709",
		"statusBarItem.remoteBackground": "#4a151d",
		"statusBarItem.remoteForeground": "#ffb454",

		// Panel
		"panel.background": "#0d0509",
		"panel.border": "#2a0d12",
		"panelTitle.activeBorder": "#ff4d6d",
		"panelTitle.activeForeground": "#f0a3ac",
		"panelTitle.inactiveForeground": "#7a4650",

		// Inputs / Dropdowns
		"input.background": "#120609",
		"input.border": "#3d131a",
		"input.foreground": "#d1707c",
		"input.placeholderForeground": "#7a4650",
		"inputOption.activeBorder": "#ff4d6d",
		"inputOption.activeBackground": "#3d131a",
		"inputValidation.errorBackground": "#4a0410",
		"inputValidation.errorBorder": "#ff1744",
		"inputValidation.infoBackground": "#0e2740",
		"inputValidation.infoBorder": "#5eb3f6",
		"inputValidation.warningBackground": "#3d2a08",
		"inputValidation.warningBorder": "#ffd166",
		"dropdown.background": "#120609",
		"dropdown.border": "#3d131a",
		"dropdown.foreground": "#d1707c",

		// Buttons / Badges
		"button.background": "#ff4d6d",
		"button.foreground": "#1a0508",
		"button.hoverBackground": "#ff6b85",
		"button.secondaryBackground": "#3d131a",
		"button.secondaryForeground": "#d1707c",
		"button.secondaryHoverBackground": "#4a151d",
		"badge.background": "#ff4d6d",
		"badge.foreground": "#1a0508",
		"extensionButton.prominentBackground": "#ff4d6d",
		"extensionButton.prominentForeground": "#1a0508",
		"extensionButton.prominentHoverBackground": "#ff6b85",
		"progressBar.background": "#ff4d6d",

		// Scrollbar
		"scrollbarSlider.background": "#3d131a70",
		"scrollbarSlider.activeBackground": "#ff4d6d80",
		"scrollbarSlider.hoverBackground": "#ff4d6d40",

		// Terminal
		"terminal.background": "#0a0407",
		"terminal.foreground": "#d1707c",
		"terminalCursor.foreground": "#ff4d6d",
		"terminal.ansiBlack": "#1a0509",
		"terminal.ansiRed": "#ff4d6d",
		"terminal.ansiGreen": "#6bcf7f",
		"terminal.ansiYellow": "#ffd166",
		"terminal.ansiBlue": "#5eb3f6",
		"terminal.ansiMagenta": "#ff6b9d",
		"terminal.ansiCyan": "#4dd0e1",
		"terminal.ansiWhite": "#d1707c",
		"terminal.ansiBrightBlack": "#5a2028",
		"terminal.ansiBrightRed": "#ff6b85",
		"terminal.ansiBrightGreen": "#8ee89f",
		"terminal.ansiBrightYellow": "#ffe08a",
		"terminal.ansiBrightBlue": "#7cc4f8",
		"terminal.ansiBrightMagenta": "#ff8fb3",
		"terminal.ansiBrightCyan": "#6fe0ef",
		"terminal.ansiBrightWhite": "#f5c6cc",

		// Debug
		"debugToolBar.background": "#120609",
		"debugToolBar.border": "#3d131a",
		"debugIcon.breakpointForeground": "#ff1744",
		"debugIcon.startForeground": "#6bcf7f",

		// Notifications / Peek / Hover
		"notificationCenter.border": "#3d131a",
		"notificationCenterHeader.background": "#170709",
		"notificationCenterHeader.foreground": "#f0a3ac",
		"notificationLink.foreground": "#5eb3f6",
		"notifications.background": "#120609",
		"notifications.foreground": "#d1707c",
		"notifications.border": "#3d131a",
		"notificationToast.border": "#3d131a",
		"peekView.border": "#ff4d6d",
		"peekViewEditor.background": "#0d0509",
		"peekViewEditor.matchHighlightBackground": "#ffb45444",
		"peekViewResult.background": "#120609",
		"peekViewResult.fileForeground": "#f0a3ac",
		"peekViewResult.lineForeground": "#b3707a",
		"peekViewResult.matchHighlightBackground": "#ffb45444",
		"peekViewResult.selectionBackground": "#3d131a",
		"peekViewResult.selectionForeground": "#ffdde1",
		"peekViewTitle.background": "#170709",
		"peekViewTitleLabel.foreground": "#f0a3ac",
		"peekViewTitleDescription.foreground": "#7a4650",

		// Links
		"textLink.foreground": "#5eb3f6",
		"textLink.activeForeground": "#ff4d6d",

		// GitLens
		"gitlens.gutterBackgroundColor": "#0a0407",
		"gitlens.gutterForegroundColor": "#b3707a",
		"gitlens.gutterUncommittedForegroundColor": "#ffd166",
		"gitlens.lineHighlightBackgroundColor": "#3d131a40",
		"gitlens.lineHighlightOverviewRulerColor": "#ff4d6d",
		"gitlens.trailingLineForegroundColor": "#7a465080",

		// Git Decorations
		"gitDecoration.untrackedResourceForeground": "#6bcf7f",
		"gitDecoration.deletedResourceForeground": "#ff1744",
		"gitDecoration.modifiedResourceForeground": "#5eb3f6",
		"gitDecoration.conflictingResourceForeground": "#ffd166",
		"gitDecoration.ignoredResourceForeground": "#5a2028",
		"gitDecoration.submoduleResourceForeground": "#ffd166",
		"gitDecoration.stageModifiedResourceForeground": "#ffb454",
		"gitDecoration.addedResourceForeground": "#6bcf7f",

		// Welcome Page
		"welcomePage.buttonBackground": "#3d131a",
		"welcomePage.buttonHoverBackground": "#4a151d"
	},
	"tokenColors": [
		{
			"settings": {
				"foreground": "#d1707c"
			}
		},
		{
			"name": "Comment",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#6b3a42"
			}
		},
		{
			"name": "Punctuation, Operators",
			"scope": [
				"punctuation",
				"punctuation.separator",
				"punctuation.terminator",
				"punctuation.accessor",
				"keyword.operator",
				"punctuation.section.embedded",
				"keyword.other.template",
				"keyword.other.substitution"
			],
			"settings": {
				"foreground": "#9c5560"
			}
		},
		{
			"name": "Keyword, Storage, Control Flow",
			"scope": [
				"keyword",
				"keyword.control",
				"storage.type",
				"storage.modifier",
				"keyword.other.unit"
			],
			"settings": {
				"foreground": "#ff4d6d"
			}
		},
		{
			"name": "String",
			"scope": ["string", "string.quoted", "string.template", "constant.other.symbol"],
			"settings": {
				"foreground": "#ffb454"
			}
		},
		{
			"name": "Regular Expressions",
			"scope": ["string.regexp"],
			"settings": {
				"foreground": "#4dd0e1"
			}
		},
		{
			"name": "Escape Characters",
			"scope": ["constant.character.escape"],
			"settings": {
				"foreground": "#4dd0e1"
			}
		},
		{
			"name": "Number, Boolean, Constant",
			"scope": [
				"constant.numeric",
				"constant.language",
				"support.constant",
				"constant.character",
				"variable.language"
			],
			"settings": {
				"foreground": "#6bcf7f"
			}
		},
		{
			"name": "Variables",
			"scope": ["variable", "variable.other", "variable.parameter"],
			"settings": {
				"foreground": "#e5a0ac"
			}
		},
		{
			"name": "Properties",
			"scope": ["variable.other.property", "meta.object-literal.key", "support.type.property-name"],
			"settings": {
				"foreground": "#f0a3ac"
			}
		},
		{
			"name": "Function, Method",
			"scope": [
				"entity.name.function",
				"meta.function-call",
				"variable.function",
				"support.function",
				"keyword.other.special-method"
			],
			"settings": {
				"foreground": "#5eb3f6"
			}
		},
		{
			"name": "Class, Type, Support",
			"scope": [
				"entity.name.class",
				"entity.name.type",
				"entity.other.inherited-class",
				"support.class",
				"support.type",
				"support.type.sys-types",
				"meta.type-parameters"
			],
			"settings": {
				"foreground": "#ffd166"
			}
		},
		{
			"name": "Decorators, Annotations",
			"scope": [
				"meta.decorator",
				"punctuation.decorator",
				"tag.decorator.js entity.name.tag.js"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#ff6b9d"
			}
		},
		{
			"name": "HTML/JSX Tag Names",
			"scope": ["entity.name.tag", "meta.tag.sgml"],
			"settings": {
				"foreground": "#ff4d6d"
			}
		},
		{
			"name": "HTML/JSX Tag Punctuation",
			"scope": [
				"punctuation.definition.tag",
				"punctuation.definition.tag.begin",
				"punctuation.definition.tag.end"
			],
			"settings": {
				"foreground": "#9c5560"
			}
		},
		{
			"name": "HTML/JSX Attributes",
			"scope": ["entity.other.attribute-name"],
			"settings": {
				"foreground": "#ffd166"
			}
		},
		{
			"name": "CSS Property Names",
			"scope": [
				"source.css support.type.property-name",
				"source.scss support.type.property-name",
				"source.sass support.type.property-name",
				"source.less support.type.property-name"
			],
			"settings": {
				"foreground": "#5eb3f6"
			}
		},
		{
			"name": "CSS Class / Selector",
			"scope": ["entity.other.attribute-name.class", "entity.name.selector"],
			"settings": {
				"foreground": "#ffb454"
			}
		},
		{
			"name": "Invalid",
			"scope": ["invalid", "invalid.illegal"],
			"settings": {
				"foreground": "#ffdde1",
				"background": "#ff1744"
			}
		},
		{
			"name": "Markup Inserted",
			"scope": ["markup.inserted"],
			"settings": { "foreground": "#6bcf7f" }
		},
		{
			"name": "Markup Deleted",
			"scope": ["markup.deleted"],
			"settings": { "foreground": "#ff1744" }
		},
		{
			"name": "Markup Changed",
			"scope": ["markup.changed"],
			"settings": { "foreground": "#5eb3f6" }
		},
		{
			"name": "URL / Link",
			"scope": ["*url*", "*link*", "*uri*"],
			"settings": { "fontStyle": "underline" }
		},
		{
			"name": "Markdown Heading",
			"scope": ["markup.heading", "markup.heading entity.name"],
			"settings": {
				"fontStyle": "bold",
				"foreground": "#ffd166"
			}
		},
		{
			"name": "Markdown Bold",
			"scope": ["markup.bold", "markup.bold string"],
			"settings": {
				"fontStyle": "bold",
				"foreground": "#f0a3ac"
			}
		},
		{
			"name": "Markdown Italic",
			"scope": ["markup.italic"],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#f0a3ac"
			}
		},
		{
			"name": "Markdown Quote",
			"scope": ["markup.quote"],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#7a4650"
			}
		},
		{
			"name": "Markdown Raw / Code Span",
			"scope": ["markup.inline.raw", "markup.raw.block"],
			"settings": { "foreground": "#ffb454" }
		},
		{
			"name": "Markdown Link Text",
			"scope": ["string.other.link.title.markdown"],
			"settings": { "foreground": "#5eb3f6" }
		},
		{
			"name": "Markdown Link URL",
			"scope": ["markup.underline.link.markdown"],
			"settings": { "foreground": "#4dd0e1" }
		},
		{
			"name": "JSON Key",
			"scope": ["source.json support.type.property-name.json"],
			"settings": { "foreground": "#f0a3ac" }
		},
		{
			"scope": "token.info-token",
			"settings": { "foreground": "#5eb3f6" }
		},
		{
			"scope": "token.warn-token",
			"settings": { "foreground": "#ffd166" }
		},
		{
			"scope": "token.error-token",
			"settings": { "foreground": "#ff1744" }
		},
		{
			"scope": "token.debug-token",
			"settings": { "foreground": "#ff6b9d" }
		}
	]
}
