{
	// Mountain Dew Code Red
	// Palette:
	//   #0a0407 / #0d0509 / #120609 / #1a0810  -- near-black red backgrounds (darkest -> raised)
	//   #d1707c  -- soft desaturated red, default text (easy on the eyes)
	//   #b33a4a  -- muted/inactive red
	//   #ff4d6d  -- bright red accent (keywords, focus, cursor)
	//   #ff1744  -- hot red (errors)
	//   #6b3a42  -- muted red-brown (comments)
	//   #ffb454  -- gold (strings)
	//   #ffd166  -- yellow (types/classes/warnings)
	//   #6bcf7f  -- green (numbers/success/added)
	//   #5eb3f6  -- blue (functions/info/modified)
	//   #4dd0e1  -- cyan (regex/links)
	//   #ff6b9d  -- pink/magenta (decorators, special)
	"name": "Mountain Dew Code Red",
	"type": "dark",
	"colors": {
		// Base
		"foreground": "#d1707c",
		"errorForeground": "#ff1744",
		"focusBorder": "#ff4d6d55",
		"selection.background": "#4a151d",
		"descriptionForeground": "#b33a4a",
		"icon.foreground": "#c56673",

		// Editor
		"editor.background": "#0a0407",
		"editor.foreground": "#d1707c",
		"editor.lineHighlightBackground": "#170709",
		"editor.lineHighlightBorder": "#170709",
		"editor.selectionBackground": "#4a151d",
		"editor.selectionHighlightBackground": "#ff4d6d22",
		"editor.selectionHighlightBorder": "#ff4d6d55",
		"editor.inactiveSelectionBackground": "#3d131a80",
		"editor.hoverHighlightBackground": "#ff4d6d1f",
		"editor.wordHighlightBackground": "#5eb3f622",
		"editor.wordHighlightStrongBackground": "#ffb45426",
		"editor.findMatchBackground": "#ffb45455",
		"editor.findMatchHighlightBackground": "#ffb45426",
		"editor.findRangeHighlightBackground": "#ff4d6d1a",
		"editorBracketMatch.background": "#ff4d6d22",
		"editorBracketMatch.border": "#ff4d6d",
		"editorCursor.foreground": "#ff4d6d",
		"editorCursor.background": "#0a0407",
		"editorWarning.foreground": "#ffd166",
		"editorError.foreground": "#ff1744",
		"editorInfo.foreground": "#5eb3f6",
		"editorHint.foreground": "#6bcf7f",
		"editorLineNumber.foreground": "#5a2028",
		"editorLineNumber.activeForeground": "#ff4d6d",
		"editorIndentGuide.background": "#2a0d12",
		"editorIndentGuide.activeBackground": "#6b2530",
		"editorRuler.foreground": "#2a0d12",
		"editorWhitespace.foreground": "#3d131a",
		"editorGutter.background": "#0a0407",
		"editorGutter.modifiedBackground": "#5eb3f6",
		"editorGutter.addedBackground": "#6bcf7f",
		"editorGutter.deletedBackground": "#ff1744",
		"editorLink.activeForeground": "#5eb3f6",
		"editorCodeLens.foreground": "#7a4650",
		"editorHoverWidget.background": "#120609f8",
		"editorHoverWidget.border": "#ff4d6d55",
		"editorSuggestWidget.background": "#120609f8",
		"editorSuggestWidget.border": "#ff4d6d40",
		"editorSuggestWidget.foreground": "#d1707c",
		"editorSuggestWidget.selectedBackground": "#4a151d",
		"editorSuggestWidget.highlightForeground": "#ffb454",
		"editorWidget.background": "#120609",
		"editorWidget.border": "#ff4d6d40",
		"editorGroup.border": "#2a0d12",
		"editorGroupHeader.tabsBackground": "#0d0509",
		"editorGroupHeader.noTabsBackground": "#0d0509",
		"editorOverviewRuler.border": "#0a0407",
		"diffEditor.insertedTextBackground": "#6bcf7f22",
		"diffEditor.removedTextBackground": "#ff174422",
		"diffEditor.diagonalFill": "#2a0d12",

		// Merge
		"merge.currentContentBackground": "#6bcf7f22",
		"merge.currentHeaderBackground": "#6bcf7f4d",
		"merge.incomingContentBackground": "#5eb3f622",
		"merge.incomingHeaderBackground": "#5eb3f64d",
		"merge.commonContentBackground": "#ff4d6d18",
		"merge.commonHeaderBackground": "#ff4d6d33",

		// Tabs
		"tab.activeBackground": "#170709",
		"tab.inactiveBackground": "#0d0509",
		"tab.activeForeground": "#f0a3ac",
		"tab.inactiveForeground": "#7a4650",
		"tab.activeBorderTop": "#ff4d6d",
		"tab.border": "#0a0407",
		"tab.hoverBackground": "#1f0a0e",
		"tab.hoverBorder": "#ff4d6d",
		"tab.unfocusedActiveBorderTop": "#5a2028",

		// Activity Bar
		"activityBar.background": "#0a0407",
		"activityBar.foreground": "#ff4d6d",
		"activityBar.inactiveForeground": "#5a2028",
		"activityBar.border": "#0a0407",
