{
	// Mountain Dew Code Blue
	// Same structure as Code Red, mirrored into blue: near-black blue backgrounds,
	// soft desaturated blue as default text, bright blue for keywords/accents, with
	// coral/red, gold, yellow, and green used deliberately to help syntax stand out.
	// Palette:
	//   #05080f / #070b16 / #0a1020 / #0f1830  -- near-black blue backgrounds (darkest -> raised)
	//   #7fb8e0  -- soft desaturated blue, default text (easy on the eyes)
	//   #4d84b3  -- muted/inactive blue
	//   #2d9cff  -- bright blue accent (keywords, focus, cursor)
	//   #ff3b30  -- hot red (errors)
	//   #3d6182  -- muted blue-grey (comments)
	//   #ffb454  -- gold (strings)
	//   #ffd166  -- yellow (types/classes/warnings)
	//   #6bcf7f  -- green (numbers/success/added)
	//   #ff5f6d  -- coral/red (functions -- the contrast accent on a blue base)
	//   #4dd0e1  -- cyan (regex/links)
	//   #ff6b9d  -- pink/magenta (decorators, special)
	"name": "Mountain Dew Code Blue",
	"type": "dark",
	"colors": {
		// Base
		"foreground": "#7fb8e0",
		"errorForeground": "#ff3b30",
		"focusBorder": "#2d9cff55",
		"selection.background": "#163564",
		"descriptionForeground": "#4d84b3",
		"icon.foreground": "#6ba3c9",

		// Editor
		"editor.background": "#05080f",
		"editor.foreground": "#7fb8e0",
		"editor.lineHighlightBackground": "#0a1424",
		"editor.lineHighlightBorder": "#0a1424",
		"editor.selectionBackground": "#163564",
		"editor.selectionHighlightBackground": "#2d9cff22",
		"editor.selectionHighlightBorder": "#2d9cff55",
		"editor.inactiveSelectionBackground": "#122a4d80",
		"editor.hoverHighlightBackground": "#2d9cff1f",
		"editor.wordHighlightBackground": "#ff5f6d22",
		"editor.wordHighlightStrongBackground": "#ffb45426",
		"editor.findMatchBackground": "#ffb45455",
		"editor.findMatchHighlightBackground": "#ffb45426",
		"editor.findRangeHighlightBackground": "#2d9cff1a",
		"editorBracketMatch.background": "#2d9cff22",
		"editorBracketMatch.border": "#2d9cff",
		"editorCursor.foreground": "#2d9cff",
		"editorCursor.background": "#05080f",
		"editorWarning.foreground": "#ffd166",
		"editorError.foreground": "#ff3b30",
		"editorInfo.foreground": "#4dd0e1",
		"editorHint.foreground": "#6bcf7f",
		"editorLineNumber.foreground": "#24446b",
		"editorLineNumber.activeForeground": "#2d9cff",
		"editorIndentGuide.background": "#101c33",
		"editorIndentGuide.activeBackground": "#25497a",
		"editorRuler.foreground": "#101c33",
		"editorWhitespace.foreground": "#16233f",
		"editorGutter.background": "#05080f",
		"editorGutter.modifiedBackground": "#2d9cff",
		"editorGutter.addedBackground": "#6bcf7f",
		"editorGutter.deletedBackground": "#ff3b30",
		"editorLink.activeForeground": "#4dd0e1",
		"editorCodeLens.foreground": "#3d6182",
		"editorHoverWidget.background": "#0a1020f8",
		"editorHoverWidget.border": "#2d9cff55",
		"editorSuggestWidget.background": "#0a1020f8",
		"editorSuggestWidget.border": "#2d9cff40",
		"editorSuggestWidget.foreground": "#7fb8e0",
		"editorSuggestWidget.selectedBackground": "#163564",
		"editorSuggestWidget.highlightForeground": "#ffb454",
		"editorWidget.background": "#0a1020",
		"editorWidget.border": "#2d9cff40",
		"editorGroup.border": "#101c33",
		"editorGroupHeader.tabsBackground": "#070b16",
		"editorGroupHeader.noTabsBackground": "#070b16",
		"editorOverviewRuler.border": "#05080f",
		"diffEditor.insertedTextBackground": "#6bcf7f22",
		"diffEditor.removedTextBackground": "#ff3b3022",
		"diffEditor.diagonalFill": "#101c33",

		// Merge
		"merge.currentContentBackground": "#6bcf7f22",
		"merge.currentHeaderBackground": "#6bcf7f4d",
		"merge.incomingContentBackground": "#ff5f6d22",
		"merge.incomingHeaderBackground": "#ff5f6d4d",
		"merge.commonContentBackground": "#2d9cff18",
		"merge.commonHeaderBackground": "#2d9cff33",

		// Tabs
		"tab.activeBackground": "#0f1830",
